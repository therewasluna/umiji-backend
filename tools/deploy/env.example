# What runs on this server, comma-separated: panel, subpage, and caddy for built-in HTTPS.
#   both on one server:                 panel,subpage
#   panel only (sub page elsewhere):    panel
#   sub page only (panel elsewhere):    subpage
COMPOSE_PROFILES=panel,subpage

# HTTPS. Pick one (DEPLOY.md, step 7):
#   Built-in: add caddy to COMPOSE_PROFILES (e.g. panel,subpage,caddy) and set the domains below.
#     Caddy takes ports 80 and 443 and gets and renews the certificates itself.
#   Your own reverse proxy, e.g. nginx: leave caddy out. Point it at the panel on 127.0.0.1:3000 and
#     the sub page on 127.0.0.1:3010 (or at umiji:3000 / umiji-subscription-page:3010 from a container
#     on umiji-network).
# The domains, e.g. panel.example.com and sub.example.com. Their DNS must point at this server.
CADDY_PANEL_DOMAIN=
CADDY_SUBPAGE_DOMAIN=
# Only with a CDN in front of these domains (e.g. Cloudflare's orange cloud): its IP ranges,
# space-separated inside double quotes, so Caddy takes the visitor's IP from the CDN instead of the
# CDN's own. E.g. CADDY_TRUSTED_PROXIES="173.245.48.0/20 103.21.244.0/22"
CADDY_TRUSTED_PROXIES=
# Only if the sub page runs on another server and reaches this panel at https://<panel domain>:
# that server's IP, so the panel keeps the visitor IPs it passes on.
CADDY_SUBPAGE_SERVER_IP=
