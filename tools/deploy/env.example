# What runs on this server, comma-separated: panel, subpage.
#   both on one server:                 panel,subpage
#   panel only (sub page elsewhere):    panel
#   sub page only (panel elsewhere):    subpage
# Point your reverse proxy at the panel on 127.0.0.1:3000 and the sub page on 127.0.0.1:3010
# (or at umiji:3000 / umiji-subscription-page:3010 from a container on umiji-network).
COMPOSE_PROFILES=panel,subpage
