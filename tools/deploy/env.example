# Umiji panel settings. Fill in the two domains, then run: docker compose up -d

# The panel's domain, e.g. panel.example.com. Its DNS must point at this server.
PANEL_DOMAIN=
# The sub page's domain, e.g. sub.example.com. Subscription links use it.
SUB_DOMAIN=

# Where the sub page runs (it has its own install, DEPLOY.md step 7):
#   yes: on this server too. This server's Caddy serves SUB_DOMAIN, so its DNS must point here as well.
#   no:  on another server. Put that server's IP in SUB_PAGE_IP, so the panel trusts the visitor IPs
#        it passes on.
SUB_PAGE_HERE=yes
SUB_PAGE_IP=

# Built-in HTTPS: Caddy takes ports 80 and 443 and gets and renews the certificates itself.
# To use your own nginx instead, make this line COMPOSE_PROFILES= (DEPLOY.md step 5b).
COMPOSE_PROFILES=caddy

# Optional panel settings (Telegram notifications, webhooks, ...) go in this file too. Copy the lines
# you need from https://github.com/therewasluna/umiji-backend/blob/main/.env.sample
